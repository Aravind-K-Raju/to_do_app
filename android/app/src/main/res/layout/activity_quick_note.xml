<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_glass_backdrop"
    android:padding="20dp"
    android:layout_gravity="center"
    android:layout_margin="24dp">

    <!-- Dialog Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Widget Quick Notes"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Edit Text area for capturing note -->
    <EditText
        android:id="@+id/note_input"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/widget_inner_glass_card"
        android:hint="Type your quick note here..."
        android:textColorHint="#6B7280"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:padding="12dp"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:scrollbars="vertical"
        android:layout_marginBottom="16dp" />

    <!-- Actions button Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#9CA3AF"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_live_badge"
            android:text="Save"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:paddingHorizontal="16dp" />
    </LinearLayout>

    <!-- Header for stashed list -->
    <TextView
        android:id="@+id/notes_list_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Existing Notes"
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Existing list scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/existing_notes_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
